# =============================================================================
# segmentation_benchmark_pipeline — tracked = code, configs, docs.
# Everything below is generated, machine-specific, or too large for git.
# =============================================================================

# --- Input data ---------------------------------------------------------
# Datasets are never tracked. Point SEGBENCH_DATA at them instead; see
# configs/datasets/README.md.
/dataset/
/datasets/
/data/
*.h5ad
*.h5
*.zarr/
*.tif
*.tiff
*.ome.tif

# --- Benchmark outputs / results ----------------------------------------
/results/
/benchmark_output/
/benchmark_results/
/outputs/
/out/
NMF_*/

# --- Generated reports & run summaries ----------------------------------
# Written into run directories by the wrappers and the report step. Docs and
# READMEs are re-included at the bottom; these are per-run artifacts.
run_summary.md
comparison.md
comparison_table.csv
segbench_summary.md
segbench_summary.csv
benchmark_stats.tsv
schema_validation_report.json
/final_report/
**/summary/
**/rctd/

# --- Logs ---------------------------------------------------------------
/logs/
*.log
slurm-*.out
slurm-*.err
*.out
*.err

# --- Intermediates & caches ---------------------------------------------
.snakemake/
work/
tmp/
scratch/
*.tmp
*.temp
.cache/
.ipynb_checkpoints/

# --- Environments & containers ------------------------------------------
# Built images are large binaries and are never tracked; the recipes that
# build them are source and are re-included at the bottom of this file.
/containers/
*.sif
*.sqsh
*.simg
*.tar
*.tar.gz
.conda/
conda-env/
venv/
.venv/
env/
.python-version

# --- Large tabular / matrix artifacts -----------------------------------
*.parquet
*.mtx
*.mtx.gz
*.csv.gz
*.tsv.gz
*.npz
*.pt
*.ckpt

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- R ------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/

# --- Editors / OS / agents ----------------------------------------------
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
*.swp

# --- Local secrets / machine-specific overrides -------------------------
.env
configs/local/
*.local.yaml
*.local.yml

# =============================================================================
# Re-included: specific small files the broad rules above would otherwise
# catch. These are narrow on purpose — a blanket `!dir/**` would also
# re-include __pycache__, configs/local/ and renv/library/.
# =============================================================================
!.gitignore
# Container recipes and build scripts are source, even though the images and
# the directory holding them are not.
!containers/
!containers/**/*.def
!containers/**/Dockerfile*
!containers/**/*.dockerfile
!containers/**/*.md
!containers/**/*.sh
!containers/**/*.sha256
!docs/**/*.md
!docs/**/*.txt
!configs/**/*.yaml
!configs/**/*.yml
!configs/**/*.md
!workflow/envs/*.yml
!workflow/configs/*.yml
!workflow/configs/*.toml
!reproducibility/**/*.yml
!reproducibility/**/*.def
!reproducibility/r/metadata/renv/activate.R
!resources/**/*.yml

# Per-machine environment resolution (copy from environments.local.example.sh)
configs/environments.local.yaml
configs/environments.local.sh
