manifest {
    name = 'SegBench for Cirro'
    author = 'Deshpande Lab'
    homePage = 'https://github.com/imlong4real/SegBench'
    description = 'Frozen lung Xenium and kidney VisiumHD segmentation benchmark'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '0.1.0-cirro.1'
}

params {
    input_dir = null
    dataset_kind = null
    sample_name = 'segbench_sample'
    run_scope = 'smoke'
    seed = 20260909
    input_manifest = 'input_manifest.json'

    // Lung Xenium inputs (relative to the selected Cirro dataset).
    transcripts = 'filtered_df_standardized.parquet'
    xenium_dir = '.'
    clusters = 'analysis/clustering/gene_expression_graphclust/clusters.csv'
    reference_train = 'references/lung_reference_train.h5ad'
    reference_holdout = null
    reference_split_manifest = 'references/lung_reference_split_manifest.json'
    pmi = null

    // Kidney VisiumHD inputs (relative to the selected Cirro dataset).
    kidney_seg_input = 'kidney_seg_input.parquet'
    visiumhd_matrix = 'square_002um/filtered_feature_bc_matrix'
    spatial_dir = 'square_002um/spatial'
    bin2cell_h5 = 'square_002um/filtered_feature_bc_matrix.h5'
    spaceranger_dir = 'square_002um'
    source_image = 'Visium_HD_Human_Kidney_FFPE_tissue_image.btf'

    smoke_xenium_transcripts = 100000
    smoke_kidney_rows = 200000
    smoke_kidney_transcripts = 200000
    smoke_kidney_bins = 50000
    max_retries = 2
    max_memory_gb = 384
    outdir = 'results'

    analysis_container = 'ghcr.io/imlong4real/segbench-analysis@sha256:98985cd498937a651cb4c278d562452606c24a9bea7095d1eecd5c7fea6a42a3'
    segger_container = 'ghcr.io/imlong4real/segbench-segger@sha256:6cf8c29e5217b294f2b2be0d975a1e9c9732a9568ceec4e7cbd2ddcc61e2776c'
    baysor_container = 'quay.io/biocontainers/baysor@sha256:4bd9546d1e63ce8e4b052faac1df0ce76f0ca1305802bd9fba8760f5cdf3ec7b'
    tracer_container = 'ghcr.io/imlong4real/segbench-tracer@sha256:7b1108f2082f3a10baa27e9976be0b58a27564d03f9af7bdb240b4c73361d4a5'
}

process {
    executor = 'local'
    container = params.analysis_container
    // Cirro exposes separate on-demand and Spot AWS Batch queues to the
    // Nextflow head node.  Smoke tests use the independent Spot queue so an
    // unavailable GPU request cannot head-of-line block their CPU contracts;
    // full runs remain on-demand.  Local executors ignore this directive.
    queue = {
        def selected = params.run_scope == 'smoke' ? System.getenv('PW_SPOT_JOB_QUEUE') : System.getenv('PW_ONDEMAND_JOB_QUEUE')
        selected ?: null
    }
    cpus = 8
    memory = { Math.min(32 * task.attempt, params.max_memory_gb as int).GB }
    time = { (12 * task.attempt).h }
    maxRetries = params.max_retries as int
    errorStrategy = { task.exitStatus in [104, 137, 143] ? 'retry' : 'terminate' }
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: prep {
        cpus = 8
        memory = { Math.min(48 * task.attempt, params.max_memory_gb as int).GB }
        time = { (8 * task.attempt).h }
    }
    withLabel: standardize {
        cpus = 8
        memory = { Math.min(64 * task.attempt, params.max_memory_gb as int).GB }
        time = { (12 * task.attempt).h }
    }
    withLabel: baysor {
        container = params.baysor_container
        cpus = 16
        memory = { Math.min(64 * task.attempt, params.max_memory_gb as int).GB }
        time = { (24 * task.attempt).h }
    }
    withLabel: proseg {
        cpus = 32
        memory = { Math.min(96 * task.attempt, params.max_memory_gb as int).GB }
        time = { (24 * task.attempt).h }
    }
    withLabel: segger_gpu {
        container = params.segger_container
        queue = { System.getenv('PW_ONDEMAND_JOB_QUEUE') ?: null }
        cpus = 16
        memory = { Math.min(96 * task.attempt, params.max_memory_gb as int).GB }
        accelerator = 1
        time = { (36 * task.attempt).h }
    }
    withLabel: r_method {
        cpus = 32
        memory = { Math.min(160 * task.attempt, params.max_memory_gb as int).GB }
        time = { (36 * task.attempt).h }
    }
    withLabel: tracer {
        container = params.tracer_container
        cpus = 32
        memory = { Math.min(192 * task.attempt, params.max_memory_gb as int).GB }
        time = { (48 * task.attempt).h }
    }
    withLabel: bin2cell {
        cpus = 16
        memory = { Math.min(128 * task.attempt, params.max_memory_gb as int).GB }
        time = { (36 * task.attempt).h }
    }
    withLabel: evaluate {
        cpus = 32
        memory = { Math.min(192 * task.attempt, params.max_memory_gb as int).GB }
        time = { (48 * task.attempt).h }
    }
}

docker.enabled = true
singularity.enabled = false

profiles {
    local {
        docker.enabled = false
        singularity.enabled = false
    }
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    cirro {
        process.executor = 'awsbatch'
        docker.enabled = true
        singularity.enabled = false
    }
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_dag.html"
    overwrite = true
}
