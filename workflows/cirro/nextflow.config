manifest {
    name = 'SegBench for Cirro'
    author = 'Deshpande Lab'
    homePage = 'https://github.com/imlong4real/SegBench'
    description = 'Frozen lung Xenium and kidney VisiumHD segmentation benchmark'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '0.1.0-cirro.1'
}

params {
    input_dir = null
    dataset_kind = null
    sample_name = 'segbench_sample'
    run_scope = 'smoke'
    seed = 20260909
    input_manifest = 'input_manifest.json'

    // Lung Xenium inputs (relative to the selected Cirro dataset).
    transcripts = 'filtered_df_standardized.parquet'
    xenium_dir = '.'
    clusters = 'analysis/clustering/gene_expression_graphclust/clusters.csv'
    reference_train = 'references/lung_reference_train.h5ad'
    reference_holdout = null
    reference_split_manifest = 'references/lung_reference_split_manifest.json'
    pmi = null

    // Kidney VisiumHD inputs (relative to the selected Cirro dataset).
    kidney_seg_input = 'kidney_seg_input.parquet'
    visiumhd_matrix = 'square_002um/filtered_feature_bc_matrix'
    spatial_dir = 'square_002um/spatial'
    bin2cell_h5 = 'square_002um/filtered_feature_bc_matrix.h5'
    spaceranger_dir = 'square_002um'
    source_image = 'Visium_HD_Human_Kidney_FFPE_tissue_image.btf'

    // Frozen-ROI imaging inputs.
    platform = null
    dataset_label = null
    roi_id = null
    density_quantile = 'q50'
    area_mm2 = 0.25
    roi_manifest = 'roi_manifest_frozen.json'
    reference_celltype_col = 'cell_type'

    // Base memory for the R refinement methods (SPLIT, cellAdmix).  cellAdmix
    // peaked at 159.6 GB on the 1.93M-transcript Atera q25 ROI and was
    // SIGKILLed against a 160 GB request, so the denser Atera ROIs start
    // higher rather than burning a predictable first attempt.
    r_method_memory_gb = 160

    smoke_xenium_transcripts = 100000
    smoke_kidney_rows = 200000
    smoke_kidney_transcripts = 200000
    smoke_kidney_bins = 50000
    max_retries = 2
    max_memory_gb = 384
    outdir = 'results'

    analysis_container = 'ghcr.io/imlong4real/segbench-analysis@sha256:98985cd498937a651cb4c278d562452606c24a9bea7095d1eecd5c7fea6a42a3'
    segger_container = 'ghcr.io/imlong4real/segbench-segger@sha256:a27dc6be8d11a66d2ec9244381e75a6dc177aca7b5e85966054f7bda77996677'
    baysor_container = 'quay.io/biocontainers/baysor@sha256:4bd9546d1e63ce8e4b052faac1df0ce76f0ca1305802bd9fba8760f5cdf3ec7b'
    tracer_container = 'ghcr.io/imlong4real/segbench-tracer@sha256:7b1108f2082f3a10baa27e9976be0b58a27564d03f9af7bdb240b4c73361d4a5'
}

// A *method* that exhausts its retries is recorded as not applicable for that
// platform rather than aborting the whole ROI.  cellAdmix needs >300 GiB on the
// 17.8k-gene Atera panel and may not fit at any allowed size; if it cannot run,
// the other five methods and the held-out evaluation must still complete and
// the failure must be reported, not hide the entire platform.  Preparation,
// standardisation and evaluation still fail hard - those are pipeline faults,
// not method limits.
def methodRetry = { Integer attempt, Integer status, int maxRetries ->
    // Retry ANY failure until the budget is spent, then record the method as
    // not applicable.  Enumerating OOM signatures did not work: on this queue a
    // container OOM has surfaced as exit 1 (cellAdmix), as no exit status at
    // all (Baysor), and as exit -9 (TRACER Seg), and each time a method was
    // wrongly given up on without ever being retried at higher memory.  A
    // genuinely deterministic error now costs at most maxRetries extra
    // attempts, which is cheap next to silently dropping a method from a
    // platform.
    attempt <= maxRetries ? 'retry' : 'ignore'
}

process {
    executor = 'local'
    container = params.analysis_container
    // Cirro exposes separate on-demand and Spot AWS Batch queues to the
    // Nextflow head node.  Smoke tests use the independent Spot queue so an
    // unavailable GPU request cannot head-of-line block their CPU contracts;
    // full runs remain on-demand.  Local executors ignore this directive.
    queue = {
        def selected = params.run_scope == 'smoke' ? System.getenv('PW_SPOT_JOB_QUEUE') : System.getenv('PW_ONDEMAND_JOB_QUEUE')
        selected ?: null
    }
    cpus = 8
    memory = { Math.min(32 * task.attempt, params.max_memory_gb as int).GB }
    time = { (12 * task.attempt).h }
    maxRetries = params.max_retries as int
    // AWS Batch reports a container OOM kill as exit 1, not 137, so a retry
    // set of [104,137,143] never fires for the one failure it exists to
    // handle and the job just terminates.  Exit 1 is therefore retried too:
    // a genuine deterministic error costs one extra attempt, an OOM gets the
    // memory escalation it needs.  Verified against three GBM whole-tissue
    // terminations that reported exit 1 on container OOM.
    errorStrategy = { (task.exitStatus == null || task.exitStatus in [1, 104, 137, 143])
                      ? 'retry' : 'terminate' }
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: prep {
        cpus = 8
        memory = { Math.min(48 * task.attempt, params.max_memory_gb as int).GB }
        time = { (8 * task.attempt).h }
    }
    withLabel: standardize {
        cpus = 8
        memory = { Math.min(64 * task.attempt, params.max_memory_gb as int).GB }
        time = { (12 * task.attempt).h }
    }
    withLabel: baysor {
        errorStrategy = { methodRetry(task.attempt, task.exitStatus, params.max_retries as int) }
        container = params.baysor_container
        cpus = 16
        // 128, not 64: Baysor was OOM-killed at the 64 GiB base on Atera q25
        // (1.93M molecules over 17,868 genes).  Over-provisioning costs nothing
        // in the reported numbers, which are measured peak RSS, not the request.
        memory = { Math.min(128 * task.attempt, params.max_memory_gb as int).GB }
        time = { (24 * task.attempt).h }
    }
    withLabel: proseg {
        errorStrategy = { methodRetry(task.attempt, task.exitStatus, params.max_retries as int) }
        cpus = 32
        memory = { Math.min(96 * task.attempt, params.max_memory_gb as int).GB }
        time = { (24 * task.attempt).h }
    }
    withLabel: segger_gpu {
        errorStrategy = { methodRetry(task.attempt, task.exitStatus, params.max_retries as int) }
        container = params.segger_container
        queue = { System.getenv('PW_ONDEMAND_JOB_QUEUE') ?: null }
        cpus = 16
        memory = { Math.min(192 * task.attempt, params.max_memory_gb as int).GB }
        accelerator = 1
        time = { (36 * task.attempt).h }
        // 192, not 96: Segger's DataLoader runs 8 CPU worker processes (not
        // CLI-configurable in v0.2.0), and on the 17,868-gene Atera q50 ROI a
        // worker was killed - "DataLoader worker exited unexpectedly" - after
        // the model had already reached training.  Host RAM, not VRAM.
    }
    withLabel: r_method {
        errorStrategy = { methodRetry(task.attempt, task.exitStatus, params.max_retries as int) }
        cpus = 32
        memory = { Math.min((params.r_method_memory_gb as int) * task.attempt,
                            params.max_memory_gb as int).GB }
        time = { (36 * task.attempt).h }
    }
    withLabel: tracer {
        errorStrategy = { methodRetry(task.attempt, task.exitStatus, params.max_retries as int) }
        container = params.tracer_container
        // 16, not 32: TRACER Seg peak RSS is driven by the worker count rather
        // than the input size.  The same GBM section that exceeded 128 GB at
        // 32 CPUs peaked at 25.7 GB and finished in 2.6 h at 16.  Halve the
        // CPUs before adding memory.
        cpus = 16
        memory = { Math.min(192 * task.attempt, params.max_memory_gb as int).GB }
        time = { (48 * task.attempt).h }
    }
    withLabel: bin2cell {
        cpus = 16
        memory = { Math.min(128 * task.attempt, params.max_memory_gb as int).GB }
        time = { (36 * task.attempt).h }
    }
    withLabel: evaluate {
        cpus = 32
        memory = { Math.min(192 * task.attempt, params.max_memory_gb as int).GB }
        time = { (48 * task.attempt).h }
    }
}

docker.enabled = true
singularity.enabled = false

profiles {
    local {
        docker.enabled = false
        singularity.enabled = false
    }
    docker {
        docker.enabled = true
        singularity.enabled = false
    }
    cirro {
        process.executor = 'awsbatch'
        docker.enabled = true
        singularity.enabled = false
    }
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_dag.html"
    overwrite = true
}
